{
    "editor.cursorBlinking": "expand",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontFamily": "'Cascadia Code PL', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.mouseWheelZoom": true,
    "terminal.integrated.mouseWheelZoom": true,
    "workbench.colorTheme": "Dark Monochrome Theme(SM)",
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "code-runner.runInTerminal": true,
    "code-runner.saveAllFilesBeforeRun": true,
    "code-runner.saveFileBeforeRun": true,
    "python.analysis.enableSnippetExtraTelemetry": true,
    "window.commandCenter": true,
    "window.title": "LabX ${activeEditorShort}",
    "files.autoSave": "onWindowChange",
    "editor.formatOnSaveMode": "modifications",
    "files.autoSaveWhenNoErrors": true,
    "files.autoSaveWorkspaceFilesOnly": true,
    "explorer.confirmDelete": false,
    "RainbowBrackets.depreciation-notice": false,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "extensions.autoRestart": true,
    "markdown.updateLinksOnFileMove.enabled": "prompt",
    "geminicodeassist.inlineSuggestions.enableAuto": true,
    "chat.tools.terminal.outputLocation": "chat",
    "terminal.integrated.initialHint": false,
    "chat.viewSessions.orientation": "stacked",
    "python.analysis.typeCheckingMode": "strict",
    "debug.onTaskErrors": "showErrors",
    "markdown.preview.breaks": true,
    "markdown.preview.typographer": true,
    "leetcode.hint.commentDescription": false,
    "leetcode.hint.configWebviewMarkdown": false,
    "leetcode.hint.commandShortcut": false,
    "jupyter.askForKernelRestart": false,
    "terminal.integrated.fontSize": 15,
    "security.workspace.trust.untrustedFiles": "open",
    "interactiveWindow.promptToSaveOnClose": true,
    "notebook.formatOnSave.enabled": true,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyType": true,
    "C_Cpp.vcFormat.newLine.closeBraceSameLine.emptyFunction": true,
    "extensions.autoCheckUpdates": false,
    "update.showPostInstallInfo": true,
    "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
    "workbench.productIconTheme": "material-symbols-rounded",
    "database-client.telemetry.usesOnlineServices": false
}