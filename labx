#!/usr/bin/env bash
# labx — run scripts / Jupyter / a shell inside the LabX Docker Python runtime
# Install: copy this file somewhere on your PATH (e.g. /usr/local/bin/labx)
#          and `chmod +x /usr/local/bin/labx`
set -euo pipefail

IMAGE="${LABX_IMAGE:-ghcr.io/SahajIVVIX-1/labx}"
TAG="${LABX_TAG:-latest}"
GPU=0

usage() {
  cat <<EOF
labx — run things inside the LabX Docker Python 3.13.14 runtime

Usage:
  labx python <script.py> [args...]      Run a script from any host location
  labx jupyter                           Start JupyterLab, mounting the current dir
  labx shell                             Open a bash shell in the container
  labx pull [tag]                        Pull an image version (default: latest)
  labx version                           Print the container's Python version

Options:
  --gpu           Use the GPU/CUDA image variant and pass --gpus all
  --tag <tag>      Use a specific image version, e.g. v1.0.0 (rollback)

Environment overrides:
  LABX_IMAGE      Override the image repo (default: ${IMAGE})
  LABX_TAG        Override the default tag (default: latest)

Examples:
  labx python analysis.py
  labx --gpu python train.py --epochs 10
  labx --tag v1.0.0 python script.py     # rollback to an older image
  labx jupyter
EOF
}

# --- parse leading flags (--gpu / --tag) before the subcommand -------------
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --gpu) GPU=1; shift ;;
    --tag) TAG="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]}"

if [[ $GPU -eq 1 ]]; then
  IMAGE="${LABX_IMAGE_GPU:-${IMAGE}-cuda}"
  GPU_FLAG="--gpus all"
else
  GPU_FLAG=""
fi

FULL_IMAGE="${IMAGE}:${TAG}"
CMD="${1:-}"
shift || true

case "$CMD" in
  python)
    SCRIPT="$1"; shift || true
    ABS_PATH="$(cd "$(dirname "$SCRIPT")" && pwd)/$(basename "$SCRIPT")"
    DIR="$(dirname "$ABS_PATH")"
    FILE="$(basename "$ABS_PATH")"
    docker run --rm -it $GPU_FLAG \
      -v "$DIR":/workspace \
      -w /workspace \
      --entrypoint python \
      "$FULL_IMAGE" "$FILE" "$@"
    ;;

  jupyter)
    docker run --rm -it $GPU_FLAG \
      -v "$(pwd)":/workspace \
      -w /workspace \
      -p 8888:8888 \
      --entrypoint jupyter \
      "$FULL_IMAGE" lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root
    ;;

  shell)
    docker run --rm -it $GPU_FLAG \
      -v "$(pwd)":/workspace \
      -w /workspace \
      --entrypoint bash \
      "$FULL_IMAGE"
    ;;

  pull)
    PULL_TAG="${1:-$TAG}"
    docker pull "${IMAGE}:${PULL_TAG}"
    ;;

  version)
    docker run --rm --entrypoint python "$FULL_IMAGE" --version
    ;;

  *)
    usage
    exit 1
    ;;
esac
