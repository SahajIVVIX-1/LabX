# =============================================================================
# LabX Portable Python Runtime — CPU variant
# Python 3.13.14, Linux, Jupyter, VS Code Dev Containers ready
# =============================================================================

FROM python:3.13.14-slim-bookworm AS base

# ---- Metadata -----------------------------------------------------------
LABEL org.opencontainers.image.title="labx" \
      org.opencontainers.image.description="LabX portable Python 3.13.14 runtime (CPU)" \
      org.opencontainers.image.source="https://github.com/SahajIVVIX-1/labx"

# ---- System / native dependencies ----------------------------------------
# libgl1/libglib for OpenCV, ffmpeg for moviepy/imageio, build-essential for
# any package that needs to compile a native extension, graphviz for the
# graphviz python binding, git for pip installs from VCS / GitPython.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        ffmpeg \
        graphviz \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ---- Non-root user ---------------------------------------------------------
# Running as non-root avoids files created in the container from ending up
# root-owned on the host (relevant for bind-mounted /workspace on Linux hosts).
ARG USERNAME=labx
ARG UID=1000
ARG GID=1000
RUN groupadd --gid ${GID} ${USERNAME} \
    && useradd --uid ${UID} --gid ${GID} --create-home --shell /bin/bash ${USERNAME}

# ---- Python environment ----------------------------------------------------
WORKDIR /tmp/build
COPY requirements-linux.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-linux.txt

# torch / torchvision / torchaudio: installed separately from the CPU wheel
# index. Version bumped from your original 2.5.1+cu121 pin because PyTorch
# only added Python 3.13 support starting in the 2.6.0 release.
RUN pip install --no-cache-dir \
        torch==2.6.0 \
        torchvision==0.21.0 \
        torchaudio==2.6.0 \
        --index-url https://download.pytorch.org/whl/cpu

# Jupyter kernel registration
RUN python -m ipykernel install --name labx-python --display-name "LabX (Python 3.13.14)"

# ---- Workspace --------------------------------------------------------------
# Nothing project-specific is copied into the image. /workspace is the mount
# point where the host bind-mounts whatever folder you're working in.
RUN mkdir -p /workspace && chown -R ${USERNAME}:${USERNAME} /workspace
WORKDIR /workspace
USER ${USERNAME}

EXPOSE 8888

ENTRYPOINT ["python"]
CMD ["--version"]
