# =============================================================================
# LabX Portable Python Runtime — GPU / CUDA variant
# Python 3.11.9, Linux, CUDA 12.6, Jupyter, VS Code Dev Containers ready
#
# Requires on the host: NVIDIA driver + NVIDIA Container Toolkit
# (Windows: via WSL2; Linux: native; macOS: not supported, no NVIDIA GPUs)
# Run with: docker run --gpus all ...
# =============================================================================

FROM nvidia/cuda:12.6.0-cudnn-devel-ubuntu24.04 AS base

LABEL org.opencontainers.image.title="labx-cuda" \
      org.opencontainers.image.description="LabX portable Python 3.11.9 runtime (CUDA 12.6)" \
      org.opencontainers.image.source="https://github.com/SahajIVVIX-1/labx"

ENV DEBIAN_FRONTEND=noninteractive

# ---- System / native dependencies ------------------------------------------
# The nvidia/cuda base image does not include Python. We install Python
# 3.11.9 via the deadsnakes PPA.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        build-essential \
        git \
        curl \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        ffmpeg \
        graphviz \
        libgomp1 \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11=3.11.9* \
        python3.11-dev=3.11.9* \
        python3.11-venv=3.11.9* \
        python3.11-distutils \
    && rm -rf /var/lib/apt/lists/*

# Make python3.11 the default `python` / `python3` / `pip` in this image
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

# ---- Non-root user ----------------------------------------------------------
ARG USERNAME=labx
ARG UID=1000
ARG GID=1000
RUN groupadd --gid ${GID} ${USERNAME} \
    && useradd --uid ${UID} --gid ${GID} --create-home --shell /bin/bash ${USERNAME}

# ---- Python environment ------------------------------------------------------
WORKDIR /tmp/build
COPY requirements-linux.txt .

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-linux.txt

# torch / torchvision / torchaudio: CUDA-enabled build matching the CUDA 12.6
# runtime above.
RUN pip install --no-cache-dir \
        torch==2.6.0+cu126 \
        torchvision==0.21.0+cu126 \
        torchaudio==2.6.0+cu126 \
        --index-url https://download.pytorch.org/whl/cu126

# TensorFlow's CUDA extras (bundles matching cuDNN/cuBLAS via pip)
RUN pip install --no-cache-dir "tensorflow[and-cuda]==2.20.0"

RUN python -m ipykernel install --name labx-python-gpu --display-name "LabX GPU (Python 3.11.9)"

RUN mkdir -p /workspace && chown -R ${USERNAME}:${USERNAME} /workspace
WORKDIR /workspace
USER ${USERNAME}

EXPOSE 8888

ENTRYPOINT ["python"]
CMD ["--version"]

# -----------------------------------------------------------------------------
# NOTE on exact patch pinning:
# deadsnakes tracks the latest patch release per minor version, so
# `python3.13=3.13.14*` will fail once deadsnakes moves past 3.13.14. At that
# point either pin the specific available patch, or replace the apt install
# block with a from-source build of CPython 3.13.14 using the same
# ./configure --enable-optimizations flow as the official Docker python
# image's Dockerfile, to guarantee the exact patch version long-term.
# -----------------------------------------------------------------------------
